# Everything is ignored unless it is listed below. Recordings, transcripts, the virtualenv, local config and
# personal prompt files therefore can never be committed by accident.
*
!.gitignore
!README.md
!README.zh-CN.md
!LICENSE
!live.py
!questions.py
!glossary.py
!courses.py
!refine.py
!run.sh
!setup.sh
!fetch_argos_zh.py
!requirements.txt
!config.example.sh
!glossary/
glossary/*
!glossary/example_*.txt
!prompts/
prompts/*
!prompts/example_*.txt
!tests/
tests/*
!tests/test_*.py
!tools/
tools/*
!tools/cloud_eval.py
